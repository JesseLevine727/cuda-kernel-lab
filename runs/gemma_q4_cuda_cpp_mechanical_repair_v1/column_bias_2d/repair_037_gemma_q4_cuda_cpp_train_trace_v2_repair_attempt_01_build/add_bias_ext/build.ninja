ninja_required_version = 1.3
cxx = c++
nvcc = /home/elfo/Documents/gemma-4-12b/cuda_kernel_lab/toolchains/cuda-13.0-local/usr/local/cuda-13.0/bin/nvcc

cflags = -DTORCH_EXTENSION_NAME=add_bias_ext -DTORCH_API_INCLUDE_EXTENSION_H -isystem /home/elfo/.local/lib/python3.12/site-packages/torch/include -isystem /home/elfo/.local/lib/python3.12/site-packages/torch/include/torch/csrc/api/include -isystem /home/elfo/Documents/gemma-4-12b/cuda_kernel_lab/toolchains/cuda-13.0-local/usr/local/cuda-13.0/include -isystem /usr/include/python3.12 -fPIC -std=c++17
post_cflags = 
cuda_cflags = -DTORCH_EXTENSION_NAME=add_bias_ext -DTORCH_API_INCLUDE_EXTENSION_H -isystem /home/elfo/.local/lib/python3.12/site-packages/torch/include -isystem /home/elfo/.local/lib/python3.12/site-packages/torch/include/torch/csrc/api/include -isystem /home/elfo/Documents/gemma-4-12b/cuda_kernel_lab/toolchains/cuda-13.0-local/usr/local/cuda-13.0/include -isystem /usr/include/python3.12 -D__CUDA_NO_HALF_OPERATORS__ -D__CUDA_NO_HALF_CONVERSIONS__ -D__CUDA_NO_BFLOAT16_CONVERSIONS__ -D__CUDA_NO_HALF2_OPERATORS__ --expt-relaxed-constexpr -gencode=arch=compute_120,code=sm_120 --compiler-options '-fPIC' -O2 -std=c++17
cuda_post_cflags = 
cuda_dlink_post_cflags = 
sycl_dlink_post_cflags = 
ldflags = -shared -L/home/elfo/.local/lib/python3.12/site-packages/torch/lib -lc10 -lc10_cuda -ltorch_cpu -ltorch_cuda -ltorch -ltorch_python -L/home/elfo/Documents/gemma-4-12b/cuda_kernel_lab/toolchains/cuda-13.0-local/usr/local/cuda-13.0/lib64 -lcudart

rule compile
  command = $cxx -MMD -MF $out.d $cflags -c $in -o $out $post_cflags
  depfile = $out.d
  deps = gcc

rule cuda_compile
  depfile = $out.d
  deps = gcc
  command = $nvcc -MD -MF $out.d $cuda_cflags -c $in -o $out $cuda_post_cflags





rule link
  command = $cxx $in $ldflags -o $out

build main.o: compile /home/elfo/Documents/gemma-4-12b/cuda_kernel_lab/runs/gemma_q4_cuda_cpp_mechanical_repair_v1/column_bias_2d/repair_037_gemma_q4_cuda_cpp_train_trace_v2_repair_attempt_01_build/add_bias_ext/main.cpp
build cuda.cuda.o: cuda_compile /home/elfo/Documents/gemma-4-12b/cuda_kernel_lab/runs/gemma_q4_cuda_cpp_mechanical_repair_v1/column_bias_2d/repair_037_gemma_q4_cuda_cpp_train_trace_v2_repair_attempt_01_build/add_bias_ext/cuda.cu





build add_bias_ext.so: link main.o cuda.cuda.o

